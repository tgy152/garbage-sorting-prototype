# ============================================================
# 复制为 .env 后按需修改。比赛材料提交时不要包含本文件。
# ============================================================

# 运行模式（决定默认的 LLM 后端与检索后端）
#   mock   : 完全离线，不调用任何外部模型，用于先跑通界面与流程
#   direct : 直连 OpenAI 兼容的大模型 API（DeepSeek / 通义 / 智谱 等）
#   dify   : 调用自托管或云端的 Dify 应用 Service API
APP_MODE=mock

# 当前场景 ID，对应 scenes/<SCENE_ID>.yaml
SCENE_ID=waste_sorting

# ---------- 大模型（APP_MODE=direct 时必填）----------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60

# ---------- 向量化（留空则自动降级为本地 TF-IDF 检索）----------
# 通义: https://dashscope.aliyuncs.com/compatible-mode/v1  text-embedding-v3
# 智谱: https://open.bigmodel.cn/api/paas/v4        embedding-3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ---------- Dify（APP_MODE=dify 时必填）----------
DIFY_API_BASE=http://localhost/v1
DIFY_API_KEY=
DIFY_DATASET_ID=

# ---------- 视觉识别 ----------
# 留空则跟随 APP_MODE：mock 模式用离线预置场景，其余模式用多模态大模型
VISION_BACKEND=
# 通义千问-VL（默认）/ 智谱 GLM-4V / OpenAI
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen-vl-max
VISION_TIMEOUT=90

# 地区分类标准：national / beijing / shanghai / guangzhou
# 影响类别名称（上海显示为"湿垃圾/干垃圾"）
REGION=national

# ---------- 检索参数 ----------
TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# 片段地板分：低于此分数的片段直接丢弃
SCORE_THRESHOLD=0.08

# 拒答门槛：最高分达到此值即放行
# 换用向量检索后分数尺度不同，请用 scripts/score_sweep.py 重新标定
REFUSE_MIN_SCORE=0.09

# 弱相关下限：低于拒答门槛时，需同时命中领域词且不低于本值才放行
WEAK_MIN_SCORE=0.05

# 相关度门控：rule（离线规则，默认）/ llm（多调一次模型判定）/ off
RELEVANCE_GATE=rule

# ---------- 界面 ----------
# 监听地址：127.0.0.1 仅本机可访问；0.0.0.0 允许同一 WiFi 下的手机访问
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false
# 启动后自动打开默认浏览器
GRADIO_INBROWSER=true

# 公网访问时的登录保护（两项都填才生效）
# 用内网穿透把服务开到公网时强烈建议设置，否则拿到链接的人都能用你的模型额度
GRADIO_AUTH_USER=
GRADIO_AUTH_PASSWORD=
